# ---------------------------------------------------------------------------
# PharmaBuy B2B - local configuration
#
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --------------------------- SQL Server connection --------------------------
# Local named instance, Windows authentication (the default setup):
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Ph_Store
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# To use SQL Server authentication instead, set DB_TRUSTED_CONNECTION=no and
# fill in the two values below.
DB_USERNAME=
DB_PASSWORD=

# ------------------------------ Optional -----------------------------------
# n8n (or any HTTP endpoint) that receives an invoice payload after checkout.
# The app ignores failures here, so leaving it unset is safe.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pharmacy-invoice

# Flask development server. Keep FLASK_DEBUG=0 when exposing the app.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
